{
  "name": "marina-bay-racer",
  "version": "1.0.0",
  "description": "Hackathon starter: browser-based multiplayer racing game (Three.js + Node.js + Socket.IO)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/race.test.mjs",
    "build": "node scripts/build-sites.mjs",
    "preview:sites": "wrangler dev --port 3001",
    "db:generate": "drizzle-kit generate",
    "test:hosting": "node --test tests/hosting.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "wrangler": "^4.131.1"
  }
}
